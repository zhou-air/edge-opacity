<Window x:Class="EdgeOpacity.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edge 透明度">
  <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="22" Padding="28,22,28,24" MaxWidth="680" HorizontalAlignment="Stretch">
        <StackPanel Spacing="6">
          <TextBlock Text="Edge 透明度" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="让桌面透过浏览器，保留你需要的内容。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Spacing="10">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="选择 Edge 窗口" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Content="刷新列表" Click="Refresh_Click" AutomationProperties.AutomationId="RefreshButton"/>
          </Grid>
          <ComboBox x:Name="WindowPicker" HorizontalAlignment="Stretch" PlaceholderText="先打开一个 Edge 窗口"
                    DisplayMemberPath="Title" SelectionChanged="WindowPicker_SelectionChanged"
                    AutomationProperties.Name="选择 Edge 窗口" AutomationProperties.AutomationId="WindowPicker"/>
          <TextBlock x:Name="WindowHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="22,18">
          <StackPanel Spacing="12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="不透明度" FontWeight="SemiBold"/>
                <TextBlock Text="数值越小，窗口越透明" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <TextBlock x:Name="PercentLabel" Grid.Column="1" Text="100%" FontFamily="Segoe UI Variable Display" FontSize="40" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Grid>
            <Slider x:Name="OpacitySlider" Minimum="5" Maximum="100" Value="100" StepFrequency="1" SmallChange="1" LargeChange="5"
                    IsEnabled="False" ValueChanged="OpacitySlider_ValueChanged" AutomationProperties.Name="不透明度百分比"
                    AutomationProperties.AutomationId="OpacitySlider"/>
            <Grid>
              <TextBlock Text="5% · 更透明" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="100% · 完全不透明" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <TextBlock Text="快捷挡位" Margin="0,8,0,0" FontWeight="SemiBold"/>
            <ContentControl x:Name="PresetsControl" IsEnabled="False" HorizontalContentAlignment="Stretch">
              <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="Preset100" Content="100%" Tag="100" Click="Preset_Click" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Preset100"/>
                <ToggleButton x:Name="Preset80" Grid.Column="1" Content="80%" Tag="80" Click="Preset_Click" HorizontalAlignment="Stretch"/>
                <ToggleButton x:Name="Preset60" Grid.Column="2" Content="60%" Tag="60" Click="Preset_Click" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="Preset60"/>
                <ToggleButton x:Name="Preset40" Grid.Column="3" Content="40%" Tag="40" Click="Preset_Click" HorizontalAlignment="Stretch"/>
                <ToggleButton x:Name="Preset20" Grid.Column="4" Content="20%" Tag="20" Click="Preset_Click" HorizontalAlignment="Stretch"/>
                <ToggleButton x:Name="Preset5" Grid.Column="5" Content="5%" Tag="5" Click="Preset_Click" HorizontalAlignment="Stretch"/>
              </Grid>
            </ContentControl>
          </StackPanel>
        </Border>
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button x:Name="RestoreSelected" Content="恢复当前窗口" IsEnabled="False" HorizontalAlignment="Stretch" Click="RestoreSelected_Click" AutomationProperties.AutomationId="RestoreSelected"/>
          <Button x:Name="RestoreAll" Grid.Column="1" Content="恢复全部窗口" IsEnabled="False" HorizontalAlignment="Stretch" Click="RestoreAll_Click" AutomationProperties.AutomationId="RestoreAll"/>
        </Grid>
        <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Severity="Informational" Message="选择窗口后，拖动滑块即可实时调整。"/>
        <StackPanel Spacing="6">
          <TextBlock x:Name="HotkeyHint" Text="Ctrl + Alt + 0：随时恢复全部窗口" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
          <TextBlock Text="关闭本程序时自动恢复。本程序调整整个 Edge 窗口，包括标签栏和地址栏。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
